{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "uplink-hours-greetings/special-dates",
    "version": "1.1.0",
    "title": "Uplink Special Dates",
    "category": "widgets",
    "icon": "calendar-alt",
    "description": "Display one saved special date or a list of upcoming holidays, closures, and sales dates.",
    "keywords": ["holiday", "hours", "sale", "event", "calendar"],
    "textdomain": "uplink-hours-greetings",
    "supports": {
        "html": false,
        "customClassName": true,
        "className": true,
        "align": ["wide", "full"],
        "spacing": { "margin": true, "padding": true },
        "typography": { "fontSize": true, "lineHeight": true },
        "color": { "text": true, "background": true, "gradients": true }
    },
    "attributes": {
        "mode": { "type": "string", "default": "upcoming", "enum": ["upcoming", "single"] },
        "date": { "type": "string", "default": "" },
        "limit": { "type": "integer", "default": 5, "minimum": 1, "maximum": 20 },
        "dateFormat": { "type": "string", "default": "F j, Y" },
        "showMessage": { "type": "boolean", "default": true },
        "showHours": { "type": "boolean", "default": true },
        "showLink": { "type": "boolean", "default": true }
    },
    "editorScript": "ulhgr-special-dates-editor",
    "editorStyle": "file:../../assets/style.css",
    "style": "file:../../assets/block-style.css"
}
